        "name": "pod",
        "options": [],
        "query": {
          "query": "label_values(etcddruid_exporter_configured_quota_backend_bytes{namespace=\"$namespace\"}, pod)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "etcd Metrics Exporter",
  "uid": "etcd-metrics-exporter",
  "version": 1,
  "weekStart": ""
}
