          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(etcddruid_exporter_configured_quota_backend_bytes{namespace=\"$namespace\"}, pod)",
        "hide": 0,
        "includeAll": true,
        "label": "Pod",
